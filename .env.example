# =============================================================================
# Agent Evaluation Dashboard — 環境變數模板
# =============================================================================
# 使用方式：
#   1. 複製這個檔案：cp .env.example .env
#   2. 填入你的真實金鑰（.env 已在 .gitignore，不會被提交）
#   3. 重啟後端：python3 backend/server.py
#
# ⚠️  警告：絕對不要把真實金鑰填在這個 .env.example 裡
#           這個檔案會被 git 追蹤，公開在 repo 中
# =============================================================================


# -----------------------------------------------------------------------------
# [必填] Google Gemini API Key
# 取得方式：https://aistudio.google.com/app/apikey
# 用途：Grounded QA 評估時使用 gemini-2.5-flash / gemini-2.5-pro 模型
# 格式：AIzaSy 開頭，共 39 個字元
# -----------------------------------------------------------------------------
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# [必填] OpenAI API Key
# 取得方式：https://platform.openai.com/api-keys
# 用途：Grounded QA 評估時使用 gpt-4o / gpt-4o-mini 模型
# 格式：sk- 或 sk-proj- 開頭
# -----------------------------------------------------------------------------
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# [選填] Ollama 本地伺服器位址
# 預設值：http://localhost:11434
# 用途：使用本地 Ollama 模型做 LLM Judge 評估
# 安裝 Ollama：https://ollama.com/download
# 啟動方式：ollama serve（背景執行）
# 拉取模型：ollama pull llama3.2
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434


# -----------------------------------------------------------------------------
# [選填] 後端伺服器 Port
# 預設值：5173
# 若 5173 被佔用可改成其他 port，例如 8080
# -----------------------------------------------------------------------------
PORT=5173
